      "versionNonce": 224084008,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Role: taken from the token only when the mirror is first created. After that the Users row is\nauthoritative - the middleware replaces the token roles claim with Users.Role on every request.\nDeactivation is local: an inactive mirror gets 401 on the next request, whatever the token says.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Role: taken from the token only when the mirror is first created. After that the Users row is\nauthoritative - the middleware replaces the token roles claim with Users.Role on every request.\nDeactivation is local: an inactive mirror gets 401 on the next request, whatever the token says.",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 13
    },
