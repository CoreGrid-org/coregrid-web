      "releases": [
        {
          "id": "platform-v1.0.0",
          "product": "platform",
          "version": "v1.0.0",
          "name": "CoreGrid v1.0.0 - First Stable Release",
          "tagline": "First Stable Release",
          "date": "2026-10-04T13:02:11Z",
          "prerelease": false,
          "githubUrl": "https://github.com/CoreGrid-org/CoreGrid/releases/tag/v1.0.0",
          "sourceUrl": "https://github.com/CoreGrid-org/CoreGrid/archive/refs/tags/v1.0.0.zip",
          "assets": [],
          "summary": [
            "CoreGrid v1.0.0 is the first stable release of the CoreGrid asset lifecycle management platform.",
            "This release builds on the v0.1.0 baseline. AI-assisted evaluation can now cover a whole fleet, the agent system has been rebuilt to be modular, maintenance gets smarter cost estimates, the Workflows page has been redesigned, and setup is one command."
          ],
          "contributors": [
            "HasithaErandika",
            "jguruge",
            "seneja",
            "NipunaBhanuka18"
          ],
          "sections": [
            {
              "heading": "What's New",
              "blocks": [
                {
                  "type": "heading",
                  "text": "Fleet-Wide Lifecycle Evaluation"
                },
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "Evaluate a whole asset type (for example, every laptop in the organisation) in a single run",
                    "Narrow an evaluation to a single asset when needed",
                    "Get a recommendation for each asset, plus an overall summary for the fleet",
                    "Only one evaluation can run at a time for the same asset type or asset",
                    "Searchable asset type and asset selectors in the new evaluation dialog"
                  ]
                },
                {
                  "type": "heading",
                  "text": "Redesigned Agentic Workflows Page"
                },
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "Summary tiles for **In progress**, **Needs a decision**, **Finished** and **Stopped safely**",
                    "**Active**, **Awaiting Approval** and **Completed** tabs",
                    "Workflow cards with a status colour, who started the evaluation, and when",
                    "A step-by-step timeline of what each agent did",
                    "Clear visuals for ranked options, the fleet action mix and per-asset results",
                    "An **Agents** tab that explains each agent, its tools and whether it uses AI"
                  ]
                },
                {
                  "type": "heading",
                  "text": "Smarter Maintenance"
                },
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "Cost suggestions based on past repairs of the same asset and asset type, with a confidence level",
                    "The suggested cost can still be edited",
                    "Photo evidence on new maintenance records",
                    "Photos upload only when the form is submitted, not when they are picked"
                  ]
                },
                {
                  "type": "heading",
                  "text": "Easier Setup and Configuration"
                },
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "One-command local setup with `./setup.sh`",
                    "All settings and secrets in one file (`backend/.env`)",
                    "`backend/.env.example` documents every setting",
                    "Reference ThunderID configuration included",
                    "A simpler README, with links to every setup guide"
                  ]
                },
                {
                  "type": "heading",
                  "text": "Performance and Database Tooling"
                },
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "Performance test suite: 50 virtual users, a 70:30 read/write mix, and report exports",
                    "Agent workflow latency testing",
                    "Slow-query capture",
                    "Database schema and migration export scripts"
                  ]
                }
              ]
            },
            {
              "heading": "Agentic Asset Evaluation",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "The agent system has been rebuilt to be modular and easier to maintain and audit."
                },
                {
                  "type": "paragraph",
                  "text": "Each evaluation runs through four specialised agents:"
                },
                {
                  "type": "code",
                  "lang": "text",
                  "code": "Planner\n   ↓\nMaintenance Analysis\n   ↓\nBudget Analysis\n   ↓\nPolicy Compliance\n   ↓\nDecision Gate"
                },
                {
                  "type": "heading",
                  "text": "Agents"
                },
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "**Planner** checks that the request is in scope and plans the evaluation",
                    "**Maintenance Analysis** calculates repair count, time between failures, cost trend and a 12-month cost projection",
                    "**Budget Analysis** compares projected repair cost with each asset's remaining value and ranks the options",
                    "**Policy Compliance** checks each recommendation against the organisation's policy rules",
                    "**Decision Gate** routes the result for approval, completes it as advice, or stops it safely"
                  ]
                },
                {
                  "type": "heading",
                  "text": "Improvements in This Release"
                },
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "Each agent can only use its own read-only tools",
                    "All numbers are calculated by the system; AI only helps rank the options",
                    "A second AI provider is used if the first is unavailable",
                    "If no AI provider is available, the system falls back to rule-based results, so evaluations always finish",
                    "A blocked recommendation is replaced with the next action that policy allows",
                    "Disposal recommendations always require Administrator approval",
                    "A request for revision re-runs the evaluation without suggesting the rejected action again"
                  ]
                }
              ]
            },
            {
              "heading": "Security and Auditability",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "Agents cannot change business records",
                    "Tool access is limited to each agent's own read-only tools",
                    "Policy decisions use deterministic rules, never AI",
                    "Every agent step is recorded with its result and timing",
                    "Administrator approval is required for high-impact actions",
                    "Each approval stores the approver's reason and a snapshot of the workflow",
                    "Secrets are kept out of committed configuration files"
                  ]
                }
              ]
            },
            {
              "heading": "Upgrade Notes",
              "blocks": [
                {
                  "type": "heading",
                  "text": "Upgrading from v0.1.0"
                },
                {
                  "type": "list",
                  "ordered": true,
                  "start": 1,
                  "items": [
                    "**Run the database migration.**"
                  ]
                },
                {
                  "type": "code",
                  "lang": "bash",
                  "code": "dotnet ef database update"
                },
                {
                  "type": "paragraph",
                  "text": "This adds asset-type scope to agent workflows."
                },
                {
                  "type": "list",
                  "ordered": true,
                  "start": 2,
                  "items": [
                    "**Move your configuration.**"
                  ]
                },
                {
                  "type": "paragraph",
                  "text": "Connection strings, CORS, ThunderID, AI and storage settings now come from `backend/.env` or environment variables."
                },
                {
                  "type": "paragraph",
                  "text": "`appsettings*.json` now hold only logging settings."
                },
                {
                  "type": "paragraph",
                  "text": "See:"
                },
                {
                  "type": "code",
                  "lang": "text",
                  "code": "backend/.env.example"
                },
                {
                  "type": "list",
                  "ordered": true,
                  "start": 3,
                  "items": [
                    "**Optional:** Set `LlmFallback__ApiKey` to enable the backup AI provider."
                  ]
                },
                {
                  "type": "heading",
                  "text": "API Changes"
                },
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "`POST /api/agent-workflows` now accepts `assetTypeId`, and `assetId` is optional",
                    "Workflow responses now include scope and fleet results"
                  ]
                }
              ]
            },
            {
              "heading": "Quality",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "**452 backend tests passing**",
                    "**115 web app tests passing**",
                    "**Zero-warning build**",
                    "**CI on every push and pull request**"
                  ]
                }
              ]
            },
            {
              "heading": "Known Limitations",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "Approving a workflow records the decision but does not run the action automatically. Disposals are still completed through the disposal approval step, which requires an approved workflow.",
                    "Department budget tracking is not available yet, so the budget headroom rule is shown as not applicable.",
                    "Email and SMS notifications are not included; notifications are in-app only."
                  ]
                }
              ]
            },
            {
              "heading": "Future Enhancements",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Future releases may introduce:"
                },
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    "Automatic execution of approved actions",
                    "Department budget tracking",
                    "Offline field operation and sync",
                    "Push, email and SMS notifications",
                    "Configurable lifecycle workflows",
                    "Predictive failure analysis",
                    "Computer-vision condition assessment",
                    "ERP and financial-system integrations",
                    "Multi-tenant SaaS and billing"
                  ]
                }
              ]
            },
            {
              "heading": "Project Status",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "CoreGrid v1.0.0 is the first stable release."
                },
                {
                  "type": "paragraph",
                  "text": "Assets can be managed end to end, with AI helping on fleet-wide decisions while every important action stays controlled, auditable and approved by a person."
                },
                {
                  "type": "quote",
                  "text": "**CoreGrid v1.0.0 - First Stable Release.**"
                }
              ]
            }
          ]
        },
        {
